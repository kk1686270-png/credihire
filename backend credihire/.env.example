APP_ENV=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=65536
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=INFO
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=
LLM_MODEL=
# Groq is supported through its OpenAI-compatible API. Keep the key only in .env or deployment secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional absolute path to tesseract.exe when it is not on PATH.
TESSERACT_CMD=
# Optional: factory path returning an object with analyze(ScamAnalysisRequest), e.g. team_rules.engine:create_engine
RULE_ENGINE_FACTORY=
# Resend account email delivery. Use a sender/domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# OAuth 2.0 Web client ID; must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
FRONTEND_BASE_URL=http://localhost:5173
# Use a persistent volume path in deployments.
AUTH_DATABASE_PATH=data/credihire-auth.sqlite3
